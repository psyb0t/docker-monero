# Copy to .env and fill in. Every value here is a placeholder.

# Required. Every API and MCP call needs `Authorization: Bearer <token>`.
# At least 32 characters; generate one with: openssl rand -hex 32
DOCKER_MONERO_API_TOKEN=replace-with-a-long-random-token-0000000000

# mainnet, stagenet, testnet, or regtest.
DOCKER_MONERO_NETWORK=mainnet

# Pruned keeps about a third of the full chain on disk. Choose before the
# first sync; switching later means resyncing.
DOCKER_MONERO_PRUNE=true

# Restricted RPC for wallets such as Cake Wallet, published on 18089.
DOCKER_MONERO_RESTRICTED_RPC_ENABLED=true
# Advertise the restricted RPC to other nodes as a public node.
DOCKER_MONERO_PUBLIC_NODE=false

# Write switches. READ_ONLY refuses every write (creating or restoring
# wallets, new subaddresses, sends, regtest mining) and wins over the rest.
DOCKER_MONERO_READ_ONLY=false
DOCKER_MONERO_ALLOW_TRANSFERS=true
# Lets MCP clients (AI agents) send funds. Off unless you want that.
DOCKER_MONERO_MCP_ALLOW_TRANSFERS=false

# Wallet pool.
DOCKER_MONERO_MAX_OPEN_WALLETS=8

# Extra monerod flags, space-separated, for example "--out-peers=32".
DOCKER_MONERO_MONEROD_EXTRA_ARGS=
