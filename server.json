{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.psyb0t/monero",
  "title": "Monero",
  "description": "A Monero node and programmatic wallets over HTTP and MCP: node state, wallets, balances, transfers.",
  "version": "0.0.0",
  "repository": {
    "url": "https://github.com/psyb0t/docker-monero",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "docker.io/psyb0t/monero:latest",
      "runtimeHint": "docker",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8080/mcp"
      }
    }
  ]
}
