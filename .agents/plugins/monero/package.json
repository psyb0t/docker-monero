{
  "name": "@psyb0t/monero",
  "version": "0.0.0",
  "mcpName": "io.github.psyb0t/monero",
  "description": "Connect an OpenClaw/MCP agent to a self-hosted docker-monero node and wallets over MCP.",
  "type": "module",
  "bin": {
    "monero-mcp": "bin/cli.js"
  },
  "files": [
    "bin",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "WTFPL",
  "author": "psyb0t",
  "homepage": "https://github.com/psyb0t/docker-monero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psyb0t/docker-monero.git"
  },
  "bugs": {
    "url": "https://github.com/psyb0t/docker-monero/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "monero",
    "xmr",
    "wallet",
    "openclaw",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mcp-remote": "0.1.38"
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "extensions": [
      "./bin/cli.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    }
  }
}
